void setup() {
Serial.begin(9600);
}

void loop() {
  Serial.println("nineninedan");
  for (int i = 1 ; i <= 9 ; i++)
  {
    for (int j = 1 ; j <= 9 ; j++)
    {
      Serial.print(i);
      Serial.print(" * ");
      Serial.print(j);
      Serial.print(" = ");
      Serial.println(i*j);
    }
  }
  delay(1000);
}
